# PostgreSQL connection string (Prisma). Plain Postgres 15+; the only extension used is pg_trgm.
# Prisma creates the database on first `prisma migrate dev` if it doesn't exist.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/attractive_home"

# First admin user, created by the seed (docs/DATABASE.md §8 step 2).
# NOTE: the real admin email is an OPEN DECISION (see README) — placeholder until decided.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_use_a_strong_password"

# Public site origin, used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL="https://www.attractivehome.ae"

# S3 media bases (defaults match the live buckets; override only if they move).
# Site media, portfolio projects and Shopify-era product images:
NEXT_PUBLIC_MEDIA_BASE="https://s3.ap-south-1.amazonaws.com/attractive.home.ae"
# Catalog-source product media, visualizer assets:
NEXT_PUBLIC_CATALOG_MEDIA_BASE="https://s3.ap-south-1.amazonaws.com/chinas-catalog-media"

# GA4 measurement id (leave empty to disable analytics).
NEXT_PUBLIC_GA_ID=""
