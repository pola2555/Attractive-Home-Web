// docs/DATABASE.md §5 — module: catalog.
// Ten facet lookup tables in one identical shape (id, code UNIQUE, sort_order,
// is_active, timestamps + companion *_translations). Their seeds replace
// catalogTerms.js entirely. Generic EAV was deliberately rejected (§10).
//
// Hand-added SQL in migration 1 (Prisma can't express it — §1/§5):
//   GIN (products.code gin_trgm_ops)
//   GIN (product_translations.name gin_trgm_ops)
//   PARTIAL index on products.featured_rank WHERE featured_rank IS NOT NULL

// ---------------------------------------------------------------------------
// Facet lookups
// ---------------------------------------------------------------------------

model ProductType {
  id        String   @id @db.Uuid
  code      String   @unique // canonical EN value
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations ProductTypeTranslation[]
  products     Product[]

  @@map("product_types")
}

model ProductTypeTranslation {
  id            String @id @db.Uuid
  productTypeId String @map("product_type_id") @db.Uuid
  localeCode    String @map("locale_code") @db.VarChar(8)
  name          String

  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  locale      Locale      @relation(fields: [localeCode], references: [code], onDelete: Restrict)

  @@unique([productTypeId, localeCode])
  @@index([localeCode])
  @@map("product_type_translations")
}

